{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "framebudget",
  "main": "src/index.ts",
  // Not newer than the workerd bundled with the installed wrangler (1.20261001.1).
  "compatibility_date": "2026-10-01",
  "account_id": "c4c6b9a48d0af8cbf5b00546b388b78c",
  "routes": [
    { "pattern": "framebudget.dev", "custom_domain": true },
    { "pattern": "www.framebudget.dev", "custom_domain": true }
  ],
  "assets": {
    // Vite output of the landing site (docs/). Build it first: npm ci --prefix docs && npm run site:build.
    "directory": "./docs/dist",
    "binding": "ASSETS",
    // Static files are served by the asset layer without invoking the Worker (free, not
    // counted against Worker requests). Only /api/* runs the Worker; every other path stays
    // with the asset layer, matched or not.
    "run_worker_first": ["/api/*"],
    // / serves index.html, /api and /privacy serve api.html and privacy.html (the site links
    // them without the extension), all from the asset layer without invoking the Worker.
    "html_handling": "auto-trailing-slash",
    // Paths with no matching asset get 404.html (docs/404.html) with status 404, from the
    // asset layer, without invoking the Worker.
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "framebudget",
      // created with `npx wrangler d1 create framebudget` in the owner's account
      "database_id": "bf26d7c7-9344-47cd-87d8-68584efde78a",
      "migrations_dir": "migrations"
    }
  ],
  // Burst limit of POST /api/report: 300 calls per 60 s, counted per Cloudflare location and approximate
  // (README, "Rate limits"). The Worker calls it with one constant key, never anything about the sender.
  "ratelimits": [{ "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "vars": {
    // Most lab runs (POST /api/lab/runs) created per UTC day; past it the API answers 429.
    "LAB_DAILY_CAP": "1000",
    // Most reports (POST /api/report) stored per UTC day, exact; past it the API answers 429 and writes
    // nothing. Sized so reports and the lab together stay under D1's 100,000 rows written a day (README).
    "REPORT_DAILY_CAP": "6000",
    // Kill switch of the daily auto calibration (README, "Automatic calibration"). Anything but "on"
    // stops the evaluation and makes GET /api/calibration serve calibration.json alone.
    "AUTO_CALIBRATION": "on"
  },
  // TURNSTILE_SECRET_KEY is a secret (npx wrangler secret put TURNSTILE_SECRET_KEY), never in this file;
  // local dev reads it from .dev.vars (see .dev.vars.example).
  "triggers": {
    // Daily job: deletes reports, their daily counts, lab runs and calibration log rows older than 400 days,
    // closes expired lab runs, then runs the auto calibration (one calibration_log row).
    "crons": ["17 3 * * *"]
  }
}
